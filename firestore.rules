rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validators
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('homeCity' in data) || data.homeCity == null || (data.homeCity is string && data.homeCity.size() <= 128)) &&
             (!('favoriteRegion' in data) || data.favoriteRegion == null || (data.favoriteRegion is string && data.favoriteRegion.size() <= 128)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500));
    }

    function isValidBookmark(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.itemType in ['festival', 'monument', 'city', 'state'] &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.title is string && data.title.size() <= 200;
    }

    function isValidItinerary(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.city is string && data.city.size() <= 128 &&
             data.days is number && data.days > 0 && data.days <= 30 &&
             (!('dailyPlans' in data) || data.dailyPlans is list);
    }

    function isValidVisitedPlace(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.itemType in ['festival', 'monument', 'city', 'state'] &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.title is string && data.title.size() <= 200;
    }

    function isValidQuizRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.score is number &&
             data.totalQuestions is number;
    }

    function isValidTripMemory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.destination is string && data.destination.size() <= 128 &&
             data.journalText is string && data.journalText.size() <= 4000;
    }

    function isValidCommunityReview(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 128 &&
             data.itemType in ['festival', 'monument', 'city', 'state'] &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             (!('itemTitle' in data) || data.itemTitle == null || (data.itemTitle is string && data.itemTitle.size() <= 200)) &&
             (!('reviewText' in data) || data.reviewText == null || (data.reviewText is string && data.reviewText.size() <= 2000)) &&
             (!('travelTip' in data) || data.travelTip == null || (data.travelTip is string && data.travelTip.size() <= 2000)) &&
             (!('culturalInsight' in data) || data.culturalInsight == null || (data.culturalInsight is string && data.culturalInsight.size() <= 2000)) &&
             (!('experienceDate' in data) || data.experienceDate == null || (data.experienceDate is string && data.experienceDate.size() <= 64)) &&
             (!('userAvatar' in data) || data.userAvatar == null || (data.userAvatar is string && data.userAvatar.size() <= 512));
    }

    // User collection & sub-collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow delete: if isOwner(userId);

      // Bookmarks
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBookmark(incoming());
        allow update: if isOwner(userId) && isValidBookmark(incoming());
        allow delete: if isOwner(userId);
      }

      // Itineraries
      match /itineraries/{itineraryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidItinerary(incoming());
        allow update: if isOwner(userId) && isValidItinerary(incoming());
        allow delete: if isOwner(userId);
      }

      // Visited Places
      match /visitedPlaces/{placeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVisitedPlace(incoming());
        allow update: if isOwner(userId) && isValidVisitedPlace(incoming());
        allow delete: if isOwner(userId);
      }

      // Trip Memories
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTripMemory(incoming());
        allow update: if isOwner(userId) && isValidTripMemory(incoming());
        allow delete: if isOwner(userId);
      }

      // Quiz History
      match /quizHistory/{quizId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuizRecord(incoming());
        allow update: if isOwner(userId) && isValidQuizRecord(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Community reviews and traveler memories
    match /communityReviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidCommunityReview(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidCommunityReview(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Health / connection test rule
    match /test/connection {
      allow read: if true;
    }
  }
}
